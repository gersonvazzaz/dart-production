---
import Layout from '../layouts/Layout.astro';
import { frontmatter as hub } from '../../content/progetti-hub.md';

const slugMap: Record<string, string> = {
  'Stampa': '/progetti/stampa',
  'Allestimento': '/progetti/allestimento',
  'Personalizzazione': '/progetti/personalizzazione',
  'Eventi': '/progetti/eventi',
};

const bgClasses = ['bg-white', 'bg-light', 'bg-white', 'bg-light'];
const reverses = [false, true, false, true];
---
<Layout page="progetti" title="Progetti — Dart Production">

  <section class="hero-inner">
    <span class="eyebrow">{hub.hero.eyebrow}</span>
    <h1 class="headline-xl">{hub.hero.title}</h1>
    <p class="body-lg" style="max-width:560px; text-align:center; margin-top:16px;">{hub.hero.subtitle}</p>
  </section>

  {hub.sections.map((s: any, i: number) => (
    <section class={`section ${bgClasses[i] || 'bg-white'}`}>
      <div class="container">
        <div class={`detail-row ${reverses[i] ? 'reverse' : ''} reveal`}>
          <div>
            <span class="eyebrow">{s.eyebrow}</span>
            <h2 class="headline-md">{s.title}</h2>
            <p class="body-lg" style="margin-top:16px; margin-bottom:32px;">{s.description}</p>
            <a href={slugMap[s.title] || '/progetti'} class="btn btn-primary btn-arrow">{s.buttonLabel}</a>
          </div>
          <div class="detail-img">{s.image ? <img src={s.image} alt={s.title} /> : s.imagePlaceholder}</div>
        </div>
      </div>
    </section>
  ))}

  <section class="cta-block">
    <div class="container reveal">
      <h2 class="headline-md">{hub.cta.title}</h2>
      <p class="body-lg" style="max-width:500px; margin:0 auto 40px;">{hub.cta.text}</p>
      <a href="/contatti" class="btn btn-primary btn-arrow">{hub.cta.button}</a>
    </div>
  </section>

</Layout>
