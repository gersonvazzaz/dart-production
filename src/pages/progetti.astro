---
import Layout from '../layouts/Layout.astro';
import { frontmatter as data } from '../../content/progetti.md';

const sections = data.sections;
const bgClass = (i: number) => (i % 2 === 1 ? 'bg-light' : 'bg-white');
---
<Layout page="progetti" title="Progetti — Dart Production">

  <section class="hero-inner">
    <span class="eyebrow">{data.hero.eyebrow}</span>
    <h1 class="headline-xl">{data.hero.title}</h1>
    <p class="body-lg" style="max-width:560px; text-align:center; margin-top:16px;">{data.hero.subtitle}</p>
  </section>

  {sections.map((s: any, i: number) => (
    <section class={`section ${bgClass(i)}`}>
      <div class="container">
        <div class={`detail-row ${i % 2 === 1 ? 'reverse' : ''} reveal`}>
          <div>
            <span class="eyebrow">{s.eyebrow}</span>
            <h2 class="headline-md">{s.title}</h2>
            <p class="body-lg" style="margin-top:16px; margin-bottom:32px;">{s.description}</p>
            <a href={s.href} class="btn btn-primary btn-arrow">{s.buttonLabel}</a>
          </div>
          <div class="detail-img">{s.imagePlaceholder}</div>
        </div>
      </div>
    </section>
  ))}

  <section class="cta-block">
    <div class="container reveal">
      <h2 class="headline-md">{data.cta.title}</h2>
      <p class="body-lg" style="max-width:500px; margin:0 auto 40px;">{data.cta.text}</p>
      <a href="/contatti" class="btn btn-primary btn-arrow">{data.cta.button}</a>
    </div>
  </section>

</Layout>
